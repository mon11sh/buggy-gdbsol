# Supabase-over-Docker settings. Copy this file to `.env` (same folder as the
# compose files), then run:  dotnet run --project tools/Gdb.DockerUp -- supabase
#
# Get these from your Supabase project → Connect → Session pooler (port 5432).
# All services share Supabase's single `postgres` database.

# Full connection URI for auth/users/accounts (ends in :5432/postgres):
SUPABASE_DATABASE_URL=postgresql://postgres.abcd:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Same connection, split into parts for the transactions service:
SUPABASE_DB_HOST=aws-0-ap-south-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres.abcd
SUPABASE_DB_PASSWORD=YOUR-PASSWORD
SUPABASE_DB_NAME=postgres
