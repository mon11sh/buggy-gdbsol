{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;accounts-service;*.gdb.local",
  
  "Environment": "development",
  "AppName": "GDB-Accounts-Service",
  "Title": "GDB Accounts Service",
  "Description": "Microservice for managing bank accounts",
  "AppVersion": "1.0.0",

  "Host": "0.0.0.0",
  "Port": 8001,

  "ServiceDiscoveryEnabled": false,
  "RegistryUrl": "http://localhost:8010",
  "DiscoveryName": "accounts",

  "DataAccess": "EfCore",
  "DatabaseProvider": "sqlite",
  "AutoCreateTables": true,
  "DatabaseUrl": "",
  
  "DatabaseHost": "localhost",
  "DatabasePort": 5432,
  "DatabaseName": "gdb_accounts_db",
  "DatabaseUser": "postgres",
  "DatabasePassword": "",
  
  "_SECURITY_NOTE": "Secrets are intentionally empty. AllowInsecureDefaults=true opts this dev/teaching stack into shared dev fallbacks. PRODUCTION: set AllowInsecureDefaults=false and inject real JwtSecretKey/InternalApiKey/PinEncryptionKey via environment/secret store, or the service refuses to start.",
  "AllowInsecureDefaults": false,
  "PinEncryptionKey": "",
  "JwtSecretKey": "",
  "JwtPublicKey": "",
  "JwtAlgorithm": "HS256",
  "AccessTokenExpireMinutes": 30,
  "DisableAuth": false,
  "InternalApiKey": "",
  
  "AccountServiceTimeout": 10,
  "ApiPrefix": "/api/v1"
}
