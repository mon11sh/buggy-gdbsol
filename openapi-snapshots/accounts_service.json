          }
        },
        "additionalProperties": false
      },
      "AccountResponse": {
        "title": "AccountResponse",
        "required": [
          "bank_branch",
          "bank_name",
          "ifsc_code",
          "name",
          "privilege"
        ],
        "type": "object",
        "properties": {
          "name": {
            "title": "String",
            "maxLength": 255,
            "minLength": 2,
            "type": "string"
          },
          "privilege": {
            "title": "String",
            "minLength": 1,
            "pattern": "^(SILVER|GOLD|PREMIUM)$",
            "type": "string"
          },
          "bank_name": {
            "title": "String",
            "maxLength": 100,
            "minLength": 2,
            "type": "string"
          },
          "bank_branch": {
            "title": "String",
            "maxLength": 100,
            "minLength": 2,
            "type": "string"
          },
          "ifsc_code": {
            "title": "String",
            "minLength": 1,
            "pattern": "^[A-Z0-9]{10,11}$",
            "type": "string"
          },
          "account_number": {
            "title": "Int32",
            "type": "integer",
            "format": "int32"
          },
          "account_type": {
            "title": "String",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "balance": {
            "title": "Decimal",
            "type": "number",
            "format": "double"
          },
          "is_active": {
            "title": "Boolean",
            "type": "boolean"
          },
          "activated_date": {
            "title": "DateTime",
            "type": "string",
            "format": "date-time"
          },
          "closed_date": {
            "title": "Nullable\u00601",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "format": "date-time"
          },
          "minimum_balance": {
            "title": "Decimal",
            "type": "number",
            "format": "double"
          },
          "monthly_maintenance_fee": {
            "title": "Decimal",
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "AccountSummaryResponse": {
        "title": "AccountSummaryResponse",
        "type": "object",
        "properties": {
          "total_accounts": {
            "title": "Int32",
            "type": "integer",
            "format": "int32"
          },
          "total_balance": {
            "title": "Decimal",
            "type": "number",
            "format": "double"
          },
          "active_accounts": {
            "title": "Int32",
            "type": "integer",
            "format": "int32"
          },
          "by_type": {
            "title": "Dictionary\u00602",
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "additionalProperties": {
              "title": "Int32",
              "type": "integer",
              "format": "int32"
            }
          },
          "by_privilege": {
            "title": "Dictionary\u00602",
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "additionalProperties": {
              "title": "Int32",
              "type": "integer",
              "format": "int32"
            }
          },
          "recent_accounts": {
            "title": "List\u00601",
