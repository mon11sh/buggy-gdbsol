  "components": {
    "schemas": {
      "AccountActionResponse": {
        "title": "AccountActionResponse",
        "type": "object",
        "properties": {
          "success": {
            "title": "Boolean",
            "type": "boolean"
          },
          "message": {
            "title": "String",
            "anyOf": [
