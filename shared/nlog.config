<?xml version="1.0" encoding="utf-8" ?>
<!--
  ONE logging configuration for every GDB service (linked into each project as nlog.config).

  Development  -> human-readable console lines with the correlation id.
  Anything else -> one JSON object per line (machine-parseable by any log shipper) carrying the
                   correlation id, trace id, authenticated user, method/path and the exception.
  Correlation/trace ids come from the ILogger scope opened by Gdb.Common's CorrelationIdMiddleware.
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true">

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <targets>
    <target xsi:type="Console" name="text"
            layout="${longdate} - ${logger:shortName=true} - ${level:uppercase=true} - [${scopeproperty:CorrelationId:whenEmpty=-}] ${message}${onexception: - ${exception:format=tostring}}" />

    <target xsi:type="Console" name="json">
      <layout xsi:type="JsonLayout" includeEventProperties="true" includeScopeProperties="false">
        <attribute name="time" layout="${date:format=o:universalTime=true}" />
        <attribute name="level" layout="${level:uppercase=true}" />
        <attribute name="service" layout="${environment:GDB_SERVICE_NAME:whenEmpty=${processname}}" />
        <attribute name="logger" layout="${logger}" />
        <attribute name="message" layout="${message}" />
        <attribute name="correlation_id" layout="${scopeproperty:CorrelationId}" />
        <attribute name="trace_id" layout="${scopeproperty:TraceId}" />
        <attribute name="user" layout="${aspnet-user-identity}" />
        <attribute name="method" layout="${aspnet-request-method}" />
        <attribute name="path" layout="${aspnet-request-url:IncludeHost=false:IncludeQueryString=false}" />
        <attribute name="exception" layout="${exception:format=tostring}" />
      </layout>
    </target>
  </targets>

  <rules>
    <logger name="*" minlevel="Information" writeTo="text">
      <filters defaultAction="Log">
        <when condition="'${environment:ASPNETCORE_ENVIRONMENT}' != 'Development'" action="Ignore" />
      </filters>
    </logger>
    <logger name="*" minlevel="Information" writeTo="json">
      <filters defaultAction="Log">
        <when condition="'${environment:ASPNETCORE_ENVIRONMENT}' == 'Development'" action="Ignore" />
      </filters>
    </logger>
  </rules>
</nlog>
